{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HeatLossDB": {
    // Clerk's Frontend API address, e.g. https://<instance>.clerk.accounts.dev (Clerk dashboard,
    // API keys). Saving homes to an account needs it; without it those requests are 401s.
    "ClerkIssuer": "",
    // The website addresses allowed to send Clerk tokens, e.g. ["http://localhost:5179"]. Empty allows any.
    "ClerkAuthorizedParties": []
  }
}
