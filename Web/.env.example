# Copy to .env.local (gitignored) and fill in. Clerk dashboard → Configure → API keys.
# A publishable key isn't secret; without one the site works without sign in.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Options shown as "Coming soon": any of search, share, explore, comma-separated. Azure builds
# take theirs from .env.production.
# VITE_COMING_SOON=search,explore
